# AUDIT_HMAC_SECRET: REQUIRED for production. Signs the security audit
# trail so it's tamper-evident. If unset, the app falls back to a
# hardcoded secret sitting in this repo's source — anyone who can see
# that source could forge audit log entries with valid-looking
# signatures, defeating the entire point of a tamper-evident trail.
# Generate a real one with: openssl rand -hex 32
AUDIT_HMAC_SECRET=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Cloud Firestore & Auth Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Security settings (added by the security audit) ---
# BOOTSTRAP_ADMIN_PASSWORD: password (12-64 chars) for the bootstrap Master Admin
# (digisolutions.fm@gmail.com). If unset, that account is seeded with a random
# password nobody knows. If the account still has the old public default
# password, setting this rotates it at startup. Keep it in Cloud Run secrets.
BOOTSTRAP_ADMIN_PASSWORD=""

# SEED_DEMO_USERS=true creates fictional demo accounts (LOCAL DEV ONLY, never
# production). DEMO_USER_PASSWORD (12-64 chars) sets their password; otherwise random.
SEED_DEMO_USERS=""
DEMO_USER_PASSWORD=""

# CORS_ALLOWED_ORIGINS: extra comma-separated origins allowed to call the API
# with credentials (built in: admin.parkflows.in, parkflows.in, Capacitor, localhost).
CORS_ALLOWED_ORIGINS=""

# TRUST_PROXY_HOPS: number of trusted proxies in front of the app (default 1 =
# Cloud Run). See the comment above `app.set('trust proxy', ...)` in server.ts.
TRUST_PROXY_HOPS=""

# AI_DAILY_GLOBAL_CAP: max Gemini calls per UTC day across all users (default 5000).
AI_DAILY_GLOBAL_CAP=""
