{
  "hosting": [
    {
      "target": "admin",
      "public": "hosting-admin",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "parking-management-solution-v2-git",
            "region": "asia-south1"
          }
        }
      ]
    },
    {
      "target": "marketing",
      "public": "dist-marketing",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "trailingSlash": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=()"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/v1/demo-requests",
          "run": {
            "serviceId": "parking-management-solution-v2-git",
            "region": "asia-south1"
          }
        }
      ]
    }
  ]
}
